# ============================================================
# Dockerfile.gpu — cr_serialize_cita (NVIDIA L4 / CUDA)
# Cloud Run Job Whisper LOCAL — device=cuda compute_type=float16
# ============================================================

FROM nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04

LABEL maintainer="data-team@utpbi"
LABEL description="Cloud Run Job Whisper GPU Cita Promotor / Mentores (L4)"

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    ffmpeg \
    libgomp1 \
    ca-certificates \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV HF_HOME=/app/models
ENV HUGGINGFACE_HUB_CACHE=/app/models
ENV TRANSFORMERS_CACHE=/app/models
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

COPY requirements.txt .
RUN pip3 install --no-cache-dir --upgrade pip setuptools && \
    pip3 install --no-cache-dir -r requirements.txt

# Bake turbo during build on CPU (no GPU in Cloud Build). Runtime loads with cuda.
RUN mkdir -p /app/models && \
    python3 -c "from faster_whisper import WhisperModel; WhisperModel('deepdml/faster-whisper-large-v3-turbo-ct2', device='cpu', compute_type='int8', download_root='/app/models')"

COPY config/ ./config/
COPY main.py .

ENV WHISPER_MODEL=turbo
ENV WHISPER_DOWNLOAD_ROOT=/app/models
ENV WHISPER_DEVICE=cuda
ENV WHISPER_COMPUTE_TYPE=float16
ENV CITA_CANAL=promotor
ENV FECHA_AUDIO=""
ENV GCS_URIS=""
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

CMD ["python3", "main.py"]
